# stillwarm environment configuration
# Copy to .env and edit values.

# Silently-ineffective-restore guard thresholds.
# If the first request after a restore re-prefills more than this fraction of
# the prompt — or more than this many tokens, whichever is larger — warn.
STILLWARM_GUARD_RATIO=0.5
STILLWARM_GUARD_MIN_TOKENS=64

# Default server base URL (override per LlamaServer instance).
STILLWARM_BASE_URL=http://127.0.0.1:8080

# Default request timeout in seconds.
STILLWARM_TIMEOUT=600.0

# Disk budget for saved sessions in GB (override per Session instance).
# STILLWARM_DISK_BUDGET_GB=50.0

# Default cache directory (override per Session instance).
# STILLWARM_CACHE_DIR=/path/to/cache
